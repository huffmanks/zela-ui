{
  "name": "@zela/ui",
  "version": "0.0.0",
  "description": "A modern, accessible web component library focused exclusively on components that are non-native.",
  "homepage": "https://github.com/huffmanks/zela-ui#readme",
  "bugs": {
    "url": "https://github.com/huffmanks/zela-ui/issues"
  },
  "license": "MIT",
  "author": "Kevin Huffman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huffmanks/zela-ui.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/src/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "build": "vp run generate:types && vp pack",
    "dev": "vp run generate:types && vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "happy-dom": "catalog:",
    "typescript": "^6.0.2",
    "vite-plus": "catalog:"
  }
}
