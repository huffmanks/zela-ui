{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["packages/src/*"]
    }
  },
  "include": ["packages/src/**/*", "apps/docs/src/**/*"],
  "exclude": ["node_modules", "dist", ".changeset"]
}
