{
  "name": "zela-ui",
  "description": "A modern, accessible web component library focused exclusively on components that are non-native.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter ./apps/docs dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "check": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run e2e",
    "lint": "eslint .",
    "format": "prettier --write --list-different .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
